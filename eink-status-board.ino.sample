/*
 * ============================================================
 *  eink-status-board.ino
 *  ESP32-S3 기반 CrowPanel 3.7인치 E-paper 디스플레이
 *  WebSocket 실시간 데이터 수신 펌웨어
 * ============================================================
 *
 *  - 서버(wss://도메인:443/ws, Caddy + Let's Encrypt)에 TLS로 접속해
 *    240x416 해상도의 바이트 배열(12,480 바이트)을 바이너리로 수신합니다.
 *    서버 인증서는 내장한 Let's Encrypt 루트(ISRG Root X1/X2/YE/YR)로 검증하고,
 *    인증서의 도메인이 WS_HOST 와 같은지도 확인합니다.
 *  - 핸드셰이크에 X-Device-Token 헤더(DEVICE_TOKEN)를 실어 보냅니다.
 *    토큰이 틀리면 서버가 HTTP 403 으로 거부합니다.
 *  - 수신된 데이터를 메모리 버퍼에 저장한 뒤,
 *    updateDisplay()를 호출하여 화면을 갱신합니다.
 *  - 마지막으로 그린 프레임과 CRC32 가 같으면 다시 그리지 않습니다.
 *    (재접속할 때마다 서버가 현재 프레임을 다시 보내므로 E-paper 수명 보호)
 *    서버가 {"type":"force_refresh"} 를 보내면 다음 프레임은 무조건 그립니다.
 *  - 화면 갱신 사이에는 최소 5초 간격을 둡니다 (서버 제한과 별개인 디바이스 자체 보호).
 *    기다리는 동안 더 새 프레임이 오면 마지막 프레임만 그립니다.
 *  - 소프트웨어 재시작(ESP.restart) 뒤에는 RTC 메모리에 남긴 CRC 로
 *    화면을 지우지 않고 이어서 동작합니다. 전원 투입 등 다른 리셋은 화면을 지웁니다.
 *  - 연결이 끊어지면 자동으로 재연결을 시도하고,
 *    Wi-Fi 가 5분 넘게 끊겨 있으면 재시작합니다.
 *  - 접속 직후 hello, 이후 5분마다와 화면 갱신 직후 status 보고(JSON)를 보냅니다.
 *
 *  라이브러리 의존성:
 *    - WiFi.h          (ESP32 내장)
 *    - WebSocketsClient.h (by Markus Sattler)
 *    - EPD.h / EPD_GUI.h (Elecrow EPaperDrive 라이브러리)
 * ============================================================
 */

#include <WiFi.h>
#include <WebSocketsClient.h>
#include <esp_mac.h>     // esp_read_mac() — 디바이스 ID
#include <esp_timer.h>   // esp_timer_get_time() — 가동 시간
#include "src/EPD.h"
#include "src/EPD_GUI.h"

#define FW_VERSION "1.1.0"   // 펌웨어 버전 (hello 보고에 포함)

// ──────────────────────────────────────────────
//  사용자 설정 영역 (Wi-Fi / WebSocket 서버)
// ──────────────────────────────────────────────

// Wi-Fi 접속 정보
const char* WIFI_SSID     = "YOUR_WIFI_SSID";      // 사용할 Wi-Fi SSID
const char* WIFI_PASSWORD = "YOUR_WIFI_PASSWORD";   // 사용할 Wi-Fi 비밀번호

// WebSocket 서버 정보
// TLS 를 쓸 때 WS_HOST 는 인증서에 적힌 도메인이어야 한다 (IP 로 적으면 인증서 검증에 실패)
const char* WS_HOST = "SERVER_IP";   // WebSocket 서버 IP 또는 도메인
const char* DEVICE_TOKEN = "YOUR_DEVICE_TOKEN";   // 서버 .env 의 DEVICE_TOKEN 과 같은 값

// true : wss:// — Caddy(443) 뒤의 운영 서버. 아래 ROOT_CA_PEM 으로 인증서를 검증한다
// false: ws://  — LAN 에서 개발 서버(python main.py)에 평문으로 직접 붙을 때만. WS_PORT 를 5000 으로 바꿀 것
const bool WS_USE_TLS = true;
const uint16_t WS_PORT = 443;        // WebSocket 서버 포트 (TLS: 443, 평문 개발 서버: 5000)
const char* WS_PATH = "/ws";         // WebSocket 엔드포인트 경로

// ──────────────────────────────────────────────
//  디스플레이 관련 상수
// ──────────────────────────────────────────────

const uint16_t DISPLAY_WIDTH  = 240;    // 디스플레이 가로 해상도 (= EPD_W)
const uint16_t DISPLAY_HEIGHT = 416;    // 디스플레이 세로 해상도 (= EPD_H)
const size_t   FRAME_BUFFER_SIZE = 12480; // 240 × 416 ÷ 8 = 12,480 바이트 (1-bit BW)

// ──────────────────────────────────────────────
//  연결 감시 / 상태 보고 관련 상수
// ──────────────────────────────────────────────

const unsigned long STATUS_INTERVAL_MS   = 5UL * 60UL * 1000UL;  // 연결 중 status 보고 주기 (5분)
const unsigned long WIFI_LOST_RESTART_MS = 5UL * 60UL * 1000UL;  // Wi-Fi 가 이 시간 동안 계속 끊겨 있으면 재시작 (5분)
// 화면 갱신 사이 최소 간격. 서버의 푸시 제한(3초)과 별개로, 서버가 탈취되거나 도메인(DNS)이
// 가로채여 프레임을 쏟아내도 E-paper 수명을 지키기 위한 디바이스 자체 보호 장치
const unsigned long MIN_REFRESH_INTERVAL_MS = 5000;
const uint32_t RTC_STATE_MAGIC = 0x45494E4B;                     // "EINK" — RTC 메모리의 화면 상태가 유효하다는 표시

// ──────────────────────────────────────────────
//  TLS 루트 인증서 (Let's Encrypt: ISRG Root X1, X2, YE, YR)
// ──────────────────────────────────────────────
//  - 네 루트 인증서를 PEM 그대로 이어 붙인 문자열. 서버 체인이 이 중 하나로 이어지면 통과한다
//    (2026-10 현재 체인: 서버 ← YE1 ← Root YE(X2 교차서명) ← X2(X1 교차서명).
//     교차서명이 빠지더라도 새 루트 YE/YR 로 검증되도록 함께 넣어 둔다)
//  - mbedTLS 가 체인과 호스트 이름(WS_HOST)을 검증하고, 실패하면 접속하지 않고 5초 뒤 다시 시도한다
//  - 이 코어(esp32 3.3.7)의 mbedTLS 는 인증서 유효기간(날짜)을 검사하지 않도록 빌드되어 있어
//    (CONFIG_MBEDTLS_HAVE_TIME_DATE 꺼짐) NTP 시간 동기화 없이도 검증이 동작한다
//  - SHA-256 지문
//      ISRG Root X1: 96:BC:EC:06:26:49:76:F3:74:60:77:9A:CF:28:C5:A7:CF:E8:A3:C0:AA:E1:1A:8F:FC:EE:05:C0:BD:DF:08:C6
//      ISRG Root X2: 69:72:9B:8E:15:A8:6E:FC:17:7A:57:AF:B7:17:1D:FC:64:AD:D2:8C:2F:CA:8C:F1:50:7E:34:45:3C:CB:14:70
//      Root YE     : E1:4F:FC:AD:5B:00:25:73:10:06:CA:A4:3A:12:1A:22:D8:E9:70:0F:4F:B9:CF:85:2F:02:A7:08:AA:5D:56:66
//      Root YR     : E5:7B:7E:6F:15:0C:41:91:02:E8:D5:C0:55:72:9F:F9:67:B9:D1:A8:29:BF:00:CE:C8:9C:A6:04:EB:F4:A8:6F
