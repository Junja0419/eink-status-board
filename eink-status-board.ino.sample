// ──────────────────────────────────────────────
//  전역 변수
// ──────────────────────────────────────────────

WebSocketsClient webSocket;              // WebSocket 클라이언트 인스턴스

uint8_t frameBuffer[FRAME_BUFFER_SIZE];  // 서버로부터 수신한 프레임 데이터를 저장할 버퍼
volatile bool newFrameAvailable = false; // 새로운 프레임 데이터 수신 완료 플래그 (콜백과 loop() 양쪽에서 접근)
volatile bool forceNextRefresh  = false; // force_refresh 수신 → 다음 프레임은 CRC 가 같아도 다시 그린다
volatile bool frameBufferUpdated = false; // 콜백이 버퍼를 새로 채움 → loop()가 CRC 를 한 번만 다시 계산
uint32_t pendingCrc = 0;                 // 그리기를 기다리는 프레임의 CRC32
bool pendingWaitLogged = false;          // 최소 간격 대기 로그를 프레임마다 한 번만 찍기 위한 표시
unsigned long lastRefreshAt = 0;         // 마지막 화면 갱신이 끝난 시각 (millis)
bool refreshedSinceBoot = false;         // 부팅 후 갱신한 적이 있는지 (첫 프레임은 기다리지 않음)

// 소프트웨어 재시작(ESP.restart)에도 값이 남는 RTC 메모리.
// 전원 투입·브라운아웃 등 다른 리셋 뒤에는 쓰레기 값일 수 있으므로 setup()에서 리셋 원인과 매직으로 거른다.
RTC_NOINIT_ATTR uint32_t rtcStateMagic;  // RTC_STATE_MAGIC 이면 rtcPanelCrc 가 유효
RTC_NOINIT_ATTR uint32_t rtcPanelCrc;    // 지금 패널에 표시된 프레임의 CRC32

// 드라이버(src/EPD.cpp)는 직전 이미지를 RAM 의 oldImage 에 두고 다음 갱신 때 "이전 데이터"로 보낸다.
// 리셋되면 oldImage 가 0 으로 초기화되어 실제 화면과 달라지므로,
// 부팅 클리어를 건너뛰었다면 첫 갱신 전에 한 번 지워서 드라이버 상태를 화면과 맞춘다.
bool driverMatchesPanel = false;

char deviceId[13];                       // 디바이스 ID: Wi-Fi STA MAC 12자리 (소문자 hex, 구분자 없음)
const char* resetReasonName = "other";   // 부팅 원인 (hello 보고용)
unsigned long lastStatusSentAt = 0;      // 마지막 hello/status 보고 시각 (millis)
bool wifiDown = false;                   // Wi-Fi 끊김 감시 중인지 여부
unsigned long wifiDownSince = 0;         // Wi-Fi 가 끊긴 시각 (millis)

// ──────────────────────────────────────────────
//  함수 전방 선언
// ──────────────────────────────────────────────

void connectToWiFi();
void initWebSocket();
void webSocketEvent(WStype_t type, uint8_t* payload, size_t length);
void updateDisplay(uint8_t* buffer, size_t length);
void clearPanel();
void rememberPanelFrame(uint32_t crc);
uint32_t frameCrc32(const uint8_t* data, size_t length);
const char* resetReasonToString(esp_reset_reason_t reason);
unsigned long uptimeSeconds();
void sendHello();
void sendStatus();
void sendReport(char* json, int written, size_t capacity);
void checkWiFiWatchdog();

// ============================================================
//  setup() — 초기화
// ============================================================

void setup() {
  // 시리얼 모니터 초기화 (디버그 출력용, 115200 baud)
  Serial.begin(115200);
  delay(100);

  Serial.println();
  Serial.println("========================================");
  Serial.println("  E-ink Status Board — 부팅 시작");
  Serial.println("========================================");

  // 리셋 원인 확인 — 소프트웨어 재시작이면 화면을 지우지 않고 이어서 쓴다
  const esp_reset_reason_t resetReason = esp_reset_reason();
  resetReasonName = resetReasonToString(resetReason);
  Serial.printf("[시스템] 펌웨어 %s, 리셋 원인: %s (%d)\n", FW_VERSION, resetReasonName, (int)resetReason);

  // 디바이스 ID: Wi-Fi STA MAC (eFuse 기반이라 Wi-Fi 연결 전에도 읽을 수 있음)
  uint8_t mac[6] = {0};
  if (esp_read_mac(mac, ESP_MAC_WIFI_STA) != ESP_OK) {
    Serial.println("[시스템] ⚠️  MAC 주소를 읽지 못했습니다.");
  }
  snprintf(deviceId, sizeof(deviceId), "%02x%02x%02x%02x%02x%02x",
           mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);
  Serial.printf("[시스템] 디바이스 ID: %s\n", deviceId);

  // 프레임 버퍼를 0으로 초기화
  memset(frameBuffer, 0, FRAME_BUFFER_SIZE);

  // ── E-paper 디스플레이 초기화 ──
  // GPIO 7: CrowPanel 3.7" 디스플레이 전원 핀 (HIGH = 전원 ON)
  pinMode(7, OUTPUT);
  digitalWrite(7, HIGH);
  Serial.println("[디스플레이] 전원 ON (GPIO 7 HIGH)");

  // EPD SPI 및 GPIO 초기화
  EPD_GPIOInit();

  // 프레임 버퍼를 EPD 라이브러리에 등록
  // 파라미터: 버퍼, 너비, 높이, 회전(0=세로), 배경색
  Paint_NewImage(frameBuffer, EPD_W, EPD_H, 0, WHITE);
  Paint_Clear(WHITE);

  if (resetReason == ESP_RST_SW && rtcStateMagic == RTC_STATE_MAGIC) {
    // 소프트웨어 재시작: E-paper 는 전원이 없어도 화면을 유지하므로 지우지 않는다.
    // 마지막 CRC 도 그대로 두어, 재접속 후 같은 프레임이 오면 다시 그리지 않는다.
    driverMatchesPanel = false;
    Serial.printf("[디스플레이] 소프트웨어 재시작 — 화면 유지 (마지막 프레임 CRC %08lX)\n",
                  (unsigned long)rtcPanelCrc);
  } else {
    // 초기 화면 클리어 (흰색 화면으로 시작)
    rtcStateMagic = 0;
    clearPanel();
    driverMatchesPanel = true;

    // 지금 화면은 전부 흰색(0xFF)인 프레임과 같다 — 그 CRC 를 기록해 두면
    // 프레임을 받기 전에 소프트웨어 재시작이 반복돼도(Wi-Fi 연결 실패 등) 매번 지우지 않는다
    memset(frameBuffer, WHITE, FRAME_BUFFER_SIZE);
    rememberPanelFrame(frameCrc32(frameBuffer, FRAME_BUFFER_SIZE));
    Serial.println("[디스플레이] 초기화 완료 (화면 클리어됨)");
  }

  // 1단계: Wi-Fi 연결
  connectToWiFi();

  // 2단계: WebSocket 초기화 및 서버 연결
  initWebSocket();

  Serial.println("[시스템] 초기화 완료. 루프 진입...");
}

// ============================================================
//  loop() — 메인 루프
// ============================================================

void loop() {
  // ── WebSocket 이벤트 루프 ──
  // 반드시 매 루프마다 호출하여 연결 유지 및 수신 이벤트를 처리한다.
  // ⚠️ 주의: loop() 안에서 긴 delay()를 사용하면
  //          WebSocket 연결이 타임아웃되거나 데이터 수신이 지연된다.
  webSocket.loop();

  // ── 새 프레임이 수신되었으면 디스플레이 갱신 ──
  if (newFrameAvailable) {
    // 콜백이 버퍼를 새로 채웠을 때만 CRC 를 계산한다 (기다리는 동안 더 새 프레임이 오면 그 프레임으로 다시 계산)
    if (frameBufferUpdated) {
      frameBufferUpdated = false;
      pendingCrc = frameCrc32(frameBuffer, FRAME_BUFFER_SIZE);
      pendingWaitLogged = false;
    }
    const unsigned long sinceLastRefresh = millis() - lastRefreshAt;  // millis() 가 넘쳐도 경과 시간으로 맞게 나온다

    if (!forceNextRefresh && rtcStateMagic == RTC_STATE_MAGIC && pendingCrc == rtcPanelCrc) {
      // 마지막으로 그린 프레임과 같다 (재접속 때 서버가 다시 보낸 경우 등) → 기다리지 않고 바로 버린다
      newFrameAvailable = false;
      Serial.printf("[디스플레이] 마지막 화면과 같은 프레임 (CRC %08lX) → 갱신 생략\n", (unsigned long)pendingCrc);
    } else if (refreshedSinceBoot && sinceLastRefresh < MIN_REFRESH_INTERVAL_MS) {
      // 직전 갱신 후 최소 간격이 지나지 않았다 → 플래그를 그대로 두고 다음 루프에서 다시 확인한다
      // (그동안 webSocket.loop()·상태 보고·Wi-Fi 감시는 계속 돈다)
      if (!pendingWaitLogged) {
        pendingWaitLogged = true;
        Serial.printf("[디스플레이] 최소 갱신 간격 대기 — %lu ms 뒤 갱신\n",
                      MIN_REFRESH_INTERVAL_MS - sinceLastRefresh);
      }
    } else {
      newFrameAvailable = false;  // 플래그 초기화
      Serial.printf("[디스플레이] 새 프레임 수신 (CRC %08lX%s) → 화면 갱신 시작\n",
                    (unsigned long)pendingCrc, forceNextRefresh ? ", 강제 새로고침" : "");
      forceNextRefresh = false;
      rtcStateMagic = 0;               // 갱신 도중 리셋되면 다음 부팅 때 화면을 지우도록 먼저 무효화
      updateDisplay(frameBuffer, FRAME_BUFFER_SIZE);
      rememberPanelFrame(pendingCrc);  // CRC 는 갱신이 끝난 뒤에만 기록
      lastRefreshAt = millis();        // 최소 간격은 갱신이 끝난 시점부터 잰다
      refreshedSinceBoot = true;
      Serial.println("[디스플레이] 화면 갱신 완료");
      sendStatus();
    }
  }

  // ── 연결 중이면 5분마다 status 보고 ──
  if (webSocket.isConnected() && millis() - lastStatusSentAt >= STATUS_INTERVAL_MS) {
    sendStatus();
  }

  // ── Wi-Fi 감시: 5분 넘게 끊겨 있으면 재시작 ──
  // updateDisplay()는 위에서 동기로 끝나므로 화면 갱신 도중에 재시작되는 일은 없다
  checkWiFiWatchdog();

  // 짧은 yield — CPU 부하 방지 (1ms)
  delay(1);
}

// ============================================================
//  Wi-Fi 연결 함수
// ============================================================

void connectToWiFi() {
  Serial.printf("[Wi-Fi] SSID '%s'에 연결 시도 중...\n", WIFI_SSID);

  WiFi.mode(WIFI_STA);            // Station 모드 설정
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  // 연결 대기 (최대 약 20초)
  int retryCount = 0;
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
    retryCount++;

    if (retryCount > 40) {  // 40 × 500ms = 20초
      Serial.println();
      Serial.println("[Wi-Fi] ❌ 연결 실패! SSID/비밀번호를 확인하세요.");
      Serial.println("[Wi-Fi] 10초 후 재부팅합니다...");
      delay(10000);
      ESP.restart();  // ESP32 소프트웨어 리셋
    }
  }

  Serial.println();
  Serial.println("[Wi-Fi] ✅ 연결 성공!");
  Serial.printf("[Wi-Fi] IP 주소: %s\n", WiFi.localIP().toString().c_str());
  Serial.printf("[Wi-Fi] RSSI: %d dBm\n", WiFi.RSSI());
}

// ============================================================
//  Wi-Fi 감시 함수
//  ────────────────────────────────────────────
//  Wi-Fi 가 WIFI_LOST_RESTART_MS 동안 계속 끊겨 있으면 재시작한다.
//  (재연결에 끝내 실패한 디바이스가 영원히 멈춰 있지 않도록)
//  소프트웨어 재시작이므로 화면은 지워지지 않는다.
// ============================================================

void checkWiFiWatchdog() {
  if (WiFi.status() == WL_CONNECTED) {
    if (wifiDown) {
      wifiDown = false;
      Serial.println("[Wi-Fi] ✅ 다시 연결됨");
    }
    return;
  }

  if (!wifiDown) {
    wifiDown = true;
    wifiDownSince = millis();
    Serial.println("[Wi-Fi] ⚠️  연결 끊김 — 5분 안에 복구되지 않으면 재시작합니다");
    return;
  }

  // millis() 가 넘쳐도(약 49일) 뺄셈 결과는 경과 시간으로 맞게 나온다
  if (millis() - wifiDownSince >= WIFI_LOST_RESTART_MS) {
    Serial.println("[Wi-Fi] ❌ 5분 넘게 연결되지 않아 재시작합니다...");
    Serial.flush();
    ESP.restart();
  }
}

// ============================================================
//  WebSocket 초기화 함수
// ============================================================

void initWebSocket() {
  Serial.printf("[WebSocket] 서버 %s://%s:%u%s 에 연결 시도...\n",
                WS_USE_TLS ? "wss" : "ws", WS_HOST, (unsigned)WS_PORT, WS_PATH);

  if (strcmp(DEVICE_TOKEN, "YOUR_DEVICE_TOKEN") == 0) {
    Serial.println("[WebSocket] ⚠️  DEVICE_TOKEN 이 기본값입니다. 서버가 접속을 거부(HTTP 403)합니다.");
  }

  // WebSocket 서버에 연결 설정
  if (WS_USE_TLS) {
    // wss:// — ROOT_CA_PEM 으로 서버 인증서 체인과 호스트 이름(WS_HOST)을 검증한다
    webSocket.beginSslWithCA(WS_HOST, WS_PORT, WS_PATH, ROOT_CA_PEM);
  } else {
    // ws:// — 평문. LAN 개발용 (begin(호스트, 포트, 경로))
    webSocket.begin(WS_HOST, WS_PORT, WS_PATH);
  }

  // 핸드셰이크에 디바이스 토큰 헤더를 싣는다.
  // 라이브러리는 이 문자열을 내부 String 으로 복사해 두고 (재)접속할 때마다 보낸다.
  // (라이브러리 기본값 "Origin: file://" 헤더는 이 값으로 대체된다)
  String tokenHeader = String("X-Device-Token: ") + DEVICE_TOKEN;
  webSocket.setExtraHeaders(tokenHeader.c_str());

  // 이벤트 핸들러 등록 — 모든 WebSocket 이벤트가 이 함수로 전달됨
  webSocket.onEvent(webSocketEvent);

  // 연결이 끊어졌을 때 자동 재연결 설정
  // 재연결 간격: 5000ms (5초) — TLS 핸드셰이크 실패도 같은 간격으로 재시도한다
  webSocket.setReconnectInterval(5000);

  // 하트비트(ping) 설정 — 연결 유지 확인용
  // 15초마다 ping 전송, 3초 내 pong 응답 없으면 연결 끊김으로 판단, 최대 2회 실패 허용
  webSocket.enableHeartbeat(15000, 3000, 2);

  Serial.println("[WebSocket] 초기화 완료. 연결 대기 중...");
}

// ============================================================
//  WebSocket 이벤트 핸들러
//  ────────────────────────────────────────────
//  모든 WebSocket 이벤트(연결, 끊김, 데이터 수신 등)를
//  이 콜백 함수에서 처리한다.
// ============================================================

void webSocketEvent(WStype_t type, uint8_t* payload, size_t length) {
  switch (type) {

    // ── 연결 끊김 이벤트 ──
    // WebSocket 연결이 끊어졌을 때 호출된다.
    // setReconnectInterval()에 의해 자동 재연결이 시도되므로
    // 여기서는 로그만 출력한다.
    // payload 에는 끊긴 이유가 담길 수 있다 (예: "... HTTP 403" 이면 DEVICE_TOKEN 확인)
    case WStype_DISCONNECTED:
      if (payload != NULL && length > 0) {
        Serial.printf("[WebSocket] ⚠️  연결 끊김 (DISCONNECTED): %.*s\n", (int)length, (const char*)payload);
      } else {
        Serial.println("[WebSocket] ⚠️  연결 끊김 (DISCONNECTED)");
      }
      Serial.println("[WebSocket] 자동 재연결을 시도합니다...");
      break;

    // ── 연결 성공 이벤트 ──
    // 서버와 WebSocket 핸드셰이크가 완료되었을 때 호출된다.
    // payload에는 연결된 서버의 URL 정보가 담겨 있다.
    // 라이브러리가 연결 상태를 WSC_CONNECTED 로 바꾼 뒤 이 이벤트를 부르므로
    // 콜백 안에서 바로 hello 를 보내도 된다.
    case WStype_CONNECTED:
      Serial.printf("[WebSocket] ✅ 연결 성공! 서버 URL: %s\n", (const char*)payload);
      sendHello();
      Serial.println("[WebSocket] 바이너리 데이터 수신 대기 중...");
      break;

    // ── 텍스트 메시지 수신 이벤트 ──
    // 서버가 텍스트(문자열) 데이터를 보냈을 때 호출된다.
    // 라이브러리가 payload 끝에 NUL 을 붙여 주므로 문자열로 다룰 수 있다 (길이 0 이면 NULL).
    // {"type":"force_refresh"} 를 받으면 다음 프레임은 CRC 가 같아도 다시 그린다 (잔상 제거용).
    case WStype_TEXT:
      Serial.printf("[WebSocket] 📨 텍스트 수신 (%u 바이트): %s\n",
                    (unsigned)length, payload != NULL ? (const char*)payload : "");
      if (payload != NULL && strstr((const char*)payload, "force_refresh") != NULL) {
        forceNextRefresh = true;
        Serial.println("[WebSocket] 🔄 강제 새로고침 요청 — 다음 프레임은 무조건 다시 그립니다");
      }
      break;

    // ── 바이너리 데이터 수신 이벤트 (핵심 기능) ──
    // 서버가 보낸 240×416 해상도의 바이트 배열을 수신한다.
    // 예상 크기: 12,480 바이트 (= 240 × 416 ÷ 8)
    //
    // 수신 흐름:
    //   1. 데이터 크기 검증
    //   2. frameBuffer에 복사
    //   3. newFrameAvailable·frameBufferUpdated 플래그를 true로 설정
    //   4. loop()에서 CRC 와 최소 갱신 간격을 확인하고 필요하면 updateDisplay() 호출
    //      (아직 그리지 않은 프레임이 있으면 덮어써서 가장 새 프레임만 남긴다)
    case WStype_BIN:
      Serial.printf("[WebSocket] 📦 바이너리 수신: %u 바이트\n", (unsigned)length);

      // 수신 데이터 크기 검증
      if (length == FRAME_BUFFER_SIZE) {
        // 정상 크기 — 프레임 버퍼에 복사
        memcpy(frameBuffer, payload, length);
        newFrameAvailable = true;
        frameBufferUpdated = true;
        Serial.println("[WebSocket] ✅ 프레임 데이터 버퍼에 저장 완료");
      } else if (length > FRAME_BUFFER_SIZE) {
        // 예상보다 큰 데이터 — 크기가 다른 프레임은 정상 프레임이 아니므로 버린다
        Serial.printf("[WebSocket] ⚠️  크기 초과 프레임 무시: %u / %u bytes\n",
                      (unsigned)length, (unsigned)FRAME_BUFFER_SIZE);
      } else {
        // 예상보다 작은 데이터 — 불완전 프레임이므로 무시
        Serial.printf("[WebSocket] ⚠️  불완전 프레임 무시: %u / %u bytes\n",
                      (unsigned)length, (unsigned)FRAME_BUFFER_SIZE);
      }
      break;

    // ── Ping 수신 이벤트 ──
    // 서버가 ping을 보냈을 때 호출된다.
    // 라이브러리가 자동으로 pong을 응답하므로 별도 처리 불필요.
    case WStype_PING:
      Serial.println("[WebSocket] 🏓 Ping 수신");
      break;

    // ── Pong 수신 이벤트 ──
    // 서버가 우리의 ping에 대해 pong으로 응답했을 때 호출된다.
    case WStype_PONG:
      Serial.println("[WebSocket] 🏓 Pong 수신 — 연결 정상");
      break;

    // ── 에러 이벤트 ──
    // WebSocket 통신 중 에러가 발생했을 때 호출된다.
    case WStype_ERROR:
      Serial.printf("[WebSocket] ❌ 에러 발생! 길이: %u\n", (unsigned)length);
      break;

    // ── 기타 이벤트 ──
    default:
      Serial.printf("[WebSocket] 알 수 없는 이벤트 (type=%d)\n", (int)type);
      break;
  }
}

// ============================================================
//  상태 보고 함수
//  ────────────────────────────────────────────
//  서버에 JSON 텍스트로 상태를 보고한다.
//  서버는 apply_device_report()에서 필드의 타입·범위를 검사해 반영한다.
//    hello : 접속 직후 1회 (id, fw, rssi, uptime_s, reset)
//    status: 5분마다 + 화면 갱신 직후 (rssi, uptime_s)
// ============================================================

void sendHello() {
  char json[160];
  const int written = snprintf(json, sizeof(json),
      "{\"type\":\"hello\",\"id\":\"%s\",\"fw\":\"%s\",\"rssi\":%d,\"uptime_s\":%lu,\"reset\":\"%s\"}",
      deviceId, FW_VERSION, (int)WiFi.RSSI(), uptimeSeconds(), resetReasonName);
  sendReport(json, written, sizeof(json));
}

void sendStatus() {
  char json[80];
  const int written = snprintf(json, sizeof(json),
      "{\"type\":\"status\",\"rssi\":%d,\"uptime_s\":%lu}",
      (int)WiFi.RSSI(), uptimeSeconds());
  sendReport(json, written, sizeof(json));
}

void sendReport(char* json, int written, size_t capacity) {
  lastStatusSentAt = millis();   // 실패해도 다음 주기까지 기다린다 (매 루프 재시도 방지)

  if (written < 0 || (size_t)written >= capacity) {
    Serial.println("[보고] ⚠️  JSON 버퍼 부족 — 전송 생략");
    return;
  }
  if (!webSocket.isConnected()) {
    return;
  }

  if (webSocket.sendTXT(json, (size_t)written)) {
    Serial.printf("[보고] 📤 %s\n", json);
  } else {
    Serial.println("[보고] ⚠️  전송 실패");
  }
}

// 부팅 원인을 서버 보고용 문자열로 바꾼다
const char* resetReasonToString(esp_reset_reason_t reason) {
  switch (reason) {
    case ESP_RST_POWERON:  return "poweron";
    case ESP_RST_SW:       return "sw";
    case ESP_RST_PANIC:    return "panic";
    case ESP_RST_INT_WDT:
    case ESP_RST_TASK_WDT:
    case ESP_RST_WDT:      return "wdt";
    case ESP_RST_BROWNOUT: return "brownout";
    default:               return "other";
  }
}

// 부팅 후 경과 시간(초). millis()와 달리 약 49일 뒤에도 넘치지 않는다
unsigned long uptimeSeconds() {
  return (unsigned long)(esp_timer_get_time() / 1000000LL);
}

// ============================================================
//  프레임 CRC 함수
//  ────────────────────────────────────────────
//  CRC-32 (IEEE 802.3, 다항식 0xEDB88320 — zlib.crc32 와 같은 값).
//  SDK 버전에 묶이지 않도록 ROM 함수 대신 테이블 없이 비트 단위로 계산한다.
// ============================================================

uint32_t frameCrc32(const uint8_t* data, size_t length) {
  uint32_t crc = 0xFFFFFFFFu;
  for (size_t i = 0; i < length; i++) {
    crc ^= data[i];
    for (int bit = 0; bit < 8; bit++) {
      crc = (crc >> 1) ^ (0xEDB88320u & (0u - (crc & 1u)));
    }
  }
  return ~crc;
}

// 패널에 표시된 프레임의 CRC 를 RTC 메모리에 기록한다 (소프트웨어 재시작 후에도 유지)
void rememberPanelFrame(uint32_t crc) {
  rtcPanelCrc   = crc;
  rtcStateMagic = RTC_STATE_MAGIC;
}

// ============================================================
//  화면 클리어 함수
//  ────────────────────────────────────────────
//  화면 전체를 흰색으로 지운다. 드라이버의 oldImage 도 흰색으로 맞춰진다.
// ============================================================

void clearPanel() {
  EPD_FastInit();
  EPD_Display_Clear();
  EPD_Update();
  EPD_DeepSleep();
}

// ============================================================
//  디스플레이 갱신 함수
//  ────────────────────────────────────────────
//  서버로부터 수신한 12,480바이트 raw 바이너리를
//  CrowPanel 3.7" E-paper (UC8253) 디스플레이에 출력한다.
//
//  @param buffer  프레임 데이터가 담긴 바이트 배열 포인터
//  @param length  바이트 배열의 길이 (정상: 12,480 바이트)
//
//  흐름:
//    0. (소프트웨어 재시작 후 첫 갱신일 때만) clearPanel()
//    1. EPD_FastInit()  — 디스플레이를 DeepSleep에서 깨움
//    2. EPD_Display()   — raw 바이너리 데이터를 SPI로 전송
//    3. EPD_Update()    — 전자잉크 화면 갱신 (눈에 보이는 변경)
//    4. EPD_DeepSleep() — 저전력 모드 진입
// ============================================================

void updateDisplay(uint8_t* buffer, size_t length) {
  Serial.println("[디스플레이] updateDisplay() 호출됨");
  Serial.printf("[디스플레이] 버퍼 크기: %u 바이트\n", (unsigned)length);

  // 디버그: 첫 16바이트 출력
  Serial.printf("[디스플레이] 첫 16바이트: ");
  for (int i = 0; i < 16 && i < (int)length; i++) {
    Serial.printf("%02X ", buffer[i]);
  }
  Serial.println();

  // 0. 부팅 때 화면 클리어를 건너뛰었다면 드라이버의 이전 이미지(oldImage)가 실제 화면과 다르다.
  //    이전 데이터가 틀리면 파형에 따라 일부 픽셀이 바뀌지 않을 수 있으므로 한 번 지워서 맞춘다.
  if (!driverMatchesPanel) {
    Serial.println("[디스플레이] 재시작 후 첫 갱신 — 드라이버 상태를 맞추려고 먼저 화면을 지웁니다");
    clearPanel();
  }

  // 1. 디스플레이를 DeepSleep에서 깨움
  EPD_FastInit();

  // 2. 수신된 raw 바이너리를 디스플레이에 전송
  //    서버(Pillow)에서 생성한 1-bit 이미지가 그대로 전달됨
  EPD_Display(buffer);

  // 3. 화면 갱신 (전자잉크 새로고침)
  EPD_Update();

  // 4. 저전력 모드 진입 (디스플레이 내용은 유지됨)
  EPD_DeepSleep();
  driverMatchesPanel = true;

  Serial.println("[디스플레이] 화면 갱신 완료, DeepSleep 진입");
}
